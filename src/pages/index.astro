---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/percorsi-url';
import grafo from '../generated/graph.json';

const s = grafo.statistiche;
---

<Base
  titolo="Theatrum"
  descrizione="Atlante navigabile a grafo dell'esoterismo occidentale: correnti, concetti, pratiche, simboli, persone, opere, eventi e luoghi da Alessandria al Novecento."
>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="font-serif text-4xl text-accento">Theatrum</h1>
    <p class="mt-3 max-w-xl text-tenue">
      Scaffolding in corso — pipeline dati attiva: {s.numeroNodi} nodi, {s.numeroArchi} archi.
    </p>
    <p class="mt-6"><a class="text-accento underline" href={withBase('/grafo')}>Vai al grafo</a></p>
  </div>
</Base>
