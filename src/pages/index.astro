---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/percorsi-url';
import grafo from '../generated/graph.json';

const s = grafo.statistiche;
const percorsi = (await getCollection('percorsi')).sort((a, b) => a.data.ordine - b.data.ordine);

const porte = [
  {
    href: '/grafo',
    titolo: 'Esplora il grafo',
    testo: `${s.numeroNodi} voci e ${s.numeroArchi} relazioni: correnti, concetti, pratiche, simboli, persone, opere, eventi, luoghi.`,
    nota: 'Vista principale · alternativa accessibile: elenco delle voci',
  },
  {
    href: '/leggi',
    titolo: 'Leggi il volume',
    testo: 'Le sei parti nell’ordine originale, capitolo per capitolo, con indice e progressione di lettura.',
    nota: 'Modalità lineare',
  },
  {
    href: '/cerca',
    titolo: 'Cerca',
    testo: 'Titoli, alias, sommari e testo completo. Da qualunque pagina: Ctrl/Cmd + K.',
    nota: 'FlexSearch, indice pre-generato',
  },
];
---

<Base
  titolo="Theatrum"
  descrizione="Atlante navigabile a grafo dell'esoterismo occidentale: correnti, concetti, pratiche, simboli, persone, opere, eventi e luoghi da Alessandria al Novecento, con le genealogie leggendarie dichiarate come tali."
>
  <div class="mx-auto max-w-6xl px-4">
    <section class="pt-14 pb-10 text-center">
      <h1 class="font-serif text-5xl sm:text-6xl text-accento tracking-tight">Theatrum</h1>
      <p class="mx-auto mt-4 max-w-2xl font-serif text-xl leading-relaxed">
        Un atlante dell’esoterismo occidentale in cui la mappa delle relazioni — filiazioni
        documentate e genealogie leggendarie, dichiarate come tali — è la porta principale di
        lettura.
      </p>
    </section>

    <section aria-label="Tre porte d'ingresso" class="grid gap-4 sm:grid-cols-3 pb-6">
      {
        porte.map((porta) => (
          <a
            href={withBase(porta.href)}
            class="group rounded-lg border border-bordo bg-rialzato p-5 hover:border-bordo-forte focus-visible:border-accento"
          >
            <h2 class="font-serif text-2xl text-accento group-hover:underline underline-offset-4">
              {porta.titolo} →
            </h2>
            <p class="mt-2 text-sm leading-relaxed">{porta.testo}</p>
            <p class="mt-3 text-xs" style="color: var(--testo-tenue)">
              {porta.nota}
            </p>
          </a>
        ))
      }
    </section>

    <section aria-labelledby="titolo-percorsi" class="py-10 border-t border-bordo">
      <h2 id="titolo-percorsi" class="font-serif text-2xl">Percorsi d’autore</h2>
      <p class="mt-1 text-sm max-w-2xl" style="color: var(--testo-tenue)">
        Sequenze narrate di sei-dieci voci, con il grafo che evidenzia il cammino man mano che si
        procede.
      </p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          percorsi.map((p) => (
            <a
              href={withBase(`/percorso/${p.data.slug}`)}
              class="group rounded-lg border border-bordo bg-rialzato p-4 hover:border-bordo-forte"
            >
              <h3 class="font-serif text-lg text-accento group-hover:underline underline-offset-4">
                {p.data.titolo}
              </h3>
              <p class="mt-1 text-sm" style="color: var(--testo-tenue)">
                {p.data.sottotitolo}
              </p>
              <p class="mt-2 text-xs">{p.data.tappe.length} tappe</p>
            </a>
          ))
        }
      </div>
    </section>

    <section aria-label="Altre viste" class="pb-14">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <li><a class="underline underline-offset-4 hover:text-accento" href={withBase('/cosmo')}>Cosmo 3D</a></li>
        <li><a class="underline underline-offset-4 hover:text-accento" href={withBase('/tempo')}>Timeline</a></li>
        <li><a class="underline underline-offset-4 hover:text-accento" href={withBase('/simboli')}>Atlante dei simboli</a></li>
        <li><a class="underline underline-offset-4 hover:text-accento" href={withBase('/diagrammi')}>Diagrammi</a></li>
        <li><a class="underline underline-offset-4 hover:text-accento" href={withBase('/percorsi/trova')}>Trova un cammino fra due voci</a></li>
        <li><a class="underline underline-offset-4 hover:text-accento" href={withBase('/grafo/elenco')}>Elenco completo</a></li>
      </ul>
    </section>
  </div>
</Base>
