---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/percorsi-url';
const titoli: Record<string, [string, string]> = {
  cosmo: ['Cosmo', 'La vista tridimensionale del grafo, con il tempo sull’asse di profondità.'],
  tempo: ['Tempo', 'La timeline dell’atlante, a corsie per tipo di voce.'],
  simboli: ['Simboli', 'L’atlante dei simboli e delle correnti che li impiegano.'],
};
const nome = Astro.url.pathname.split('/').filter(Boolean).pop() ?? 'cosmo';
const [titolo, descrizione] = titoli[nome] ?? titoli.cosmo;
---
<Base titolo={titolo} descrizione={descrizione}>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="font-serif text-3xl">{titolo}</h1>
    <p class="mt-3" style="color: var(--testo-tenue)">Questa vista è in preparazione. Nel frattempo:</p>
    <ul class="mt-4 space-y-2 text-sm">
      <li><a class="underline text-accento" href={withBase('/grafo')}>Il grafo 2D</a></li>
      <li><a class="underline text-accento" href={withBase('/grafo/elenco')}>L’elenco delle voci</a></li>
    </ul>
  </div>
</Base>
